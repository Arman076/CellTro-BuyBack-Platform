generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  imageUrl     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  variantAttributes VariantAttribute[]
  brands            CategoryBrand[]
  products          Product[]
  series            ProductSeries[]

  questionnaireItems          QuestionnaireItem[]
  questionnaireDeductionRules QuestionnaireDeductionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  logoUrl      String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  categories CategoryBrand[]
  products   Product[]
  series     ProductSeries[]

  questionnaireDeductionRules QuestionnaireDeductionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryBrand {
  id         Int @id @default(autoincrement())
  categoryId Int
  brandId    Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([categoryId, brandId])
}

model Product {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String
  imageUrl     String?
  description  String?
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id])

  seriesId Int?
  series   ProductSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  variants ProductVariant[]

  questionnaireMappings       QuestionnaireItemProduct[]
  questionnaireDeductionRules QuestionnaireDeductionRule[]
  capabilities                ProductCapability[]

  enquiries EnquirySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, brandId, slug])
  @@index([seriesId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  basePrice Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  values VariantAttributeValue[]

  questionnaireDeductionRules QuestionnaireDeductionRule[]

  enquiries EnquirySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VariantAttribute {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options VariantAttributeOption[]
  values  VariantAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model VariantAttributeOption {
  id           Int     @id @default(autoincrement())
  value        String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  isDefault    Boolean @default(false)

  attributeId Int
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variantValues VariantAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, value])
}

model VariantAttributeValue {
  id Int @id @default(autoincrement())

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeId Int
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  optionId Int
  option   VariantAttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
}

enum QuestionnaireChildSelectionMode {
  SINGLE
  MULTI
}

enum QuestionnaireIssueSeverity {
  NORMAL
  SEVERE
}

enum QuestionnaireAnswerType {
  YES_NO
  SINGLE_SELECT
  MULTI_SELECT
}

enum QuestionnaireDeductionType {
  PERCENTAGE
  FIXED
}

enum QuestionnaireDeductionTrigger {
  SELECTED
  MISSING
}

enum QuestionnaireCalculationMode {
  MAX
  SUM
  SINGLE
}

enum QuestionnaireRuleScope {
  GLOBAL
  CATEGORY
  BRAND
  SERIES
  PRODUCT
  VARIANT
}

model QuestionnaireAudience {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  itemMappings QuestionnaireItemAudience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionnaireSection {
  id              Int                          @id @default(autoincrement())
  code            String                       @unique
  name            String
  displayOrder    Int                          @default(0)
  isActive        Boolean                      @default(true)
  calculationMode QuestionnaireCalculationMode @default(SUM)

  items QuestionnaireItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionnaireItem {
  id Int @id @default(autoincrement())

  code         String @unique
  name         String
  questionText String

  answerType QuestionnaireAnswerType

  displayOrder Int     @default(0)
  isRequired   Boolean @default(true)
  isActive     Boolean @default(true)

  applyToAllProducts Boolean @default(true)

  sectionId Int
  section   QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options QuestionnaireOption[]

  productMappings QuestionnaireItemProduct[]

  audiences QuestionnaireItemAudience[]

  conditions QuestionnaireCondition[] @relation("ConditionalItem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionnaireOption {
  id Int @id @default(autoincrement())

  label     String
  value     String
  issueCode String?

  // Kept temporarily so current questionnaire code/data continues to work.
  deductionPercent Decimal @default(0) @db.Decimal(5, 2)

  deductionType    QuestionnaireDeductionType    @default(PERCENTAGE)
  deductionValue   Decimal                       @default(0) @db.Decimal(12, 2)
  deductionTrigger QuestionnaireDeductionTrigger @default(SELECTED)

  // V5 option visibility / pricing policy.
  // applicabilityTargetId is interpreted by applicabilityScope.
  applicabilityScope    QuestionnaireRuleScope     @default(GLOBAL)
  applicabilityTargetId Int?
  severity              QuestionnaireIssueSeverity @default(NORMAL)
  agentRejectAllowed    Boolean                    @default(false)

  // Branching / sub-option configuration
  parentOption   QuestionnaireOption?  @relation("QuestionnaireOptionChildren", fields: [parentOptionId], references: [id], onDelete: Cascade)
  parentOptionId Int?
  childOptions   QuestionnaireOption[] @relation("QuestionnaireOptionChildren")

  // Optional visual grouping for child issues
  issueGroupId Int?
  issueGroup   QuestionnaireIssueGroup?  @relation("QuestionnaireIssueGroupChildren", fields: [issueGroupId], references: [id], onDelete: SetNull)
  issueGroups  QuestionnaireIssueGroup[] @relation("QuestionnaireIssueGroupParent")

  showChildOptions      Boolean                         @default(false)
  childPrompt           String?
  requireChildSelection Boolean                         @default(false)
  minChildSelections    Int                             @default(0)
  maxChildSelections    Int?
  childSelectionMode    QuestionnaireChildSelectionMode @default(MULTI)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  itemId Int
  item   QuestionnaireItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  dependentConditions QuestionnaireCondition[]

  deductionRules QuestionnaireDeductionRule[]
  capabilities   QuestionnaireOptionCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, value])
  @@index([parentOptionId])
  @@index([applicabilityScope, applicabilityTargetId])
  @@index([issueGroupId])
  @@index([issueCode])
}

model QuestionnaireIssueGroup {
  id           Int     @id @default(autoincrement())
  name         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  parentOptionId Int
  parentOption   QuestionnaireOption @relation("QuestionnaireIssueGroupParent", fields: [parentOptionId], references: [id], onDelete: Cascade)

  childOptions QuestionnaireOption[] @relation("QuestionnaireIssueGroupChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentOptionId, name])
  @@index([parentOptionId])
}

model QuestionnaireItemAudience {
  id Int @id @default(autoincrement())

  itemId Int
  item   QuestionnaireItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  audienceId Int
  audience   QuestionnaireAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([itemId, audienceId])
}

model QuestionnaireItemProduct {
  id Int @id @default(autoincrement())

  itemId Int
  item   QuestionnaireItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([itemId, productId])
}

model QuestionnaireCondition {
  id Int @id @default(autoincrement())

  itemId Int
  item   QuestionnaireItem @relation("ConditionalItem", fields: [itemId], references: [id], onDelete: Cascade)

  dependsOnOptionId Int
  dependsOnOption   QuestionnaireOption @relation(fields: [dependsOnOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([itemId, dependsOnOptionId])
}

model QuestionnaireDeductionRule {
  id Int @id @default(autoincrement())

  optionId Int
  option   QuestionnaireOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  scope QuestionnaireRuleScope @default(PRODUCT)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  brandId Int?
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  seriesId Int?
  series   ProductSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Kept temporarily for backward compatibility.
  deductionPercent Decimal? @db.Decimal(5, 2)

  deductionType  QuestionnaireDeductionType @default(PERCENTAGE)
  deductionValue Decimal                    @default(0) @db.Decimal(12, 2)

  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([optionId])
  @@index([scope])
  @@index([categoryId])
  @@index([brandId])
  @@index([seriesId])
  @@index([productId])
  @@index([variantId])
  @@index([optionId, scope, isActive])
}

model DeviceCapability {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  products ProductCapability[]
  options  QuestionnaireOptionCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCapability {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  capabilityId Int
  capability   DeviceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, capabilityId])
  @@index([productId])
  @@index([capabilityId])
}

model QuestionnaireOptionCapability {
  id Int @id @default(autoincrement())

  optionId Int
  option   QuestionnaireOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  capabilityId Int
  capability   DeviceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, capabilityId])
  @@index([optionId])
  @@index([capabilityId])
}

model ProductSeries {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  brandId Int
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  products Product[]

  questionnaireDeductionRules QuestionnaireDeductionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, brandId, slug])
  @@index([categoryId])
  @@index([brandId])
}

model SiteSetting {
  id Int @id @default(autoincrement())

  companyName String  @default("CELLTRO")
  tagline     String? @default("Sell Smart. Sell Easy.")

  supportPhone   String?
  whatsappNumber String?
  supportEmail   String?
  businessEmail  String?

  officeAddress String?
  city          String?
  state         String?
  pincode       String?

  businessHours String?

  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  youtubeUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermsSection {
  id           Int     @id @default(autoincrement())
  title        String
  content      String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PartnerType {
  BUYBACK_VENDOR
  PICKUP_PARTNER
  BUSINESS_PARTNER
}

enum PartnerLeadStatus {
  NEW
  CONTACTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model PartnerLead {
  id Int @id @default(autoincrement())

  fullName     String
  businessName String?
  mobile       String
  email        String?
  partnerType  PartnerType

  city            String
  pincode         String
  businessAddress String?

  gstNumber String?
  message   String?

  status PartnerLeadStatus @default(NEW)

  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([partnerType])
  @@index([mobile])
  @@index([pincode])
  @@index([createdAt])
}

enum ContactLeadStatus {
  NEW
  CONTACTED
  RESOLVED
  CLOSED
}

model ContactLead {
  id Int @id @default(autoincrement())

  fullName String
  mobile   String
  email    String?

  subject String?
  message String

  status ContactLeadStatus @default(NEW)

  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mobile])
  @@index([createdAt])
}

model QuestionnaireQuotePolicy {
  id                    Int                         @id @default(autoincrement())
  key                   String                      @unique
  scope                 QuestionnaireRuleScope      @default(GLOBAL)
  productId             Int?
  normalMinQuotePercent Decimal                     @default(10) @db.Decimal(5, 2)
  severeMinQuotePercent Decimal                     @default(2) @db.Decimal(5, 2)
  normalMinQuoteType    QuestionnaireDeductionType?
  normalMinQuoteValue   Decimal?                    @db.Decimal(12, 2)
  severeMinQuoteType    QuestionnaireDeductionType?
  severeMinQuoteValue   Decimal?                    @db.Decimal(12, 2)
  isActive              Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([scope])
  @@index([productId])
  @@index([isActive])
}

model QuestionnaireAggregationPolicy {
  id Int @id @default(autoincrement())

  key      String @unique
  level    String
  targetId Int

  scope     QuestionnaireRuleScope @default(GLOBAL)
  productId Int?

  calculationMode QuestionnaireCalculationMode
  capType         QuestionnaireDeductionType?
  capValue        Decimal?                     @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, targetId])
  @@index([scope, productId])
}

// ============================================================
// CELLTRO CHECKOUT / PICKUP / ORDER TRACKING V1
// ============================================================

enum CustomerAddressType {
  HOME
  OFFICE
  OTHER
}

enum PayoutMethod {
  CASH
  UPI
}

enum SellOrderStatus {
  PICKUP_REQUESTED
  PICKUP_CONFIRMED
  PICKUP_STARTED
  INSPECTION_COMPLETED
  PAYMENT_COMPLETED
  COMPLETED
  CANCELLED
}

model Customer {
  id              Int               @id @default(autoincrement())
  phone           String            @unique
  addresses       CustomerAddress[]
  orders          SellOrder[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  email           String?
  normalizedEmail String?

  @@index([phone])
  @@index([normalizedEmail])
}

model CustomerAddress {
  id             Int                    @id @default(autoincrement())
  customerId     Int
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName       String
  email          String?
  house          String
  street         String
  locality       String
  landmark       String?
  pincode        String
  city           String
  state          String
  type           CustomerAddressType
  isActive       Boolean                @default(true)
  orderSnapshots OrderAddressSnapshot[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([customerId])
  @@index([pincode])
  @@index([isActive])
}

model PickupSlotTemplate {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  label        String
  startTime    String
  endTime      String
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  orders       SellOrder[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([isActive, displayOrder])
}

model SellOrder {
  id                    String                 @id @default(cuid())
  orderNumber           String                 @unique
  customerId            Int
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productId             Int
  variantId             Int
  productName           String
  productImage          String?
  variantLabel          String
  basePrice             Decimal                @db.Decimal(12, 2)
  totalDeduction        Decimal                @db.Decimal(12, 2)
  finalPrice            Decimal                @db.Decimal(12, 2)
  questionnaireSnapshot Json?
  status                SellOrderStatus        @default(PICKUP_REQUESTED)
  pickupDate            DateTime               @db.Date
  pickupSlotId          Int
  pickupSlot            PickupSlotTemplate     @relation(fields: [pickupSlotId], references: [id], onDelete: Restrict)
  payoutMethod          PayoutMethod
  payoutUpiMobile       String?
  agentAssignments      OrderAgentAssignment[]

  currentVendorId        Int?
  currentVendor          Vendor?                      @relation(fields: [currentVendorId], references: [id], onDelete: Restrict)
  verificationChallenges OrderVerificationChallenge[]
  events                 OrderEvent[]
  inspection AgentOrderInspection?

  vendorAssignments OrderVendorAssignment[]

  addressSnapshot OrderAddressSnapshot?
  statusHistory   OrderStatusHistory[]
  reschedules     OrderRescheduleHistory[]

  enquiry      EnquirySession?
  cancellation OrderCancellation?
  feedback     OrderFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([pickupDate])
  @@index([pickupSlotId])
  @@index([createdAt])
  @@index([currentVendorId, status, createdAt])
}

enum OrderVendorAssignmentSource {
  AUTO
  MANUAL
  REROUTE
}

enum OrderVendorAssignmentReason {
  PINCODE_PRIORITY
  MANUAL_ADMIN
  REROUTE
}

enum OrderVendorUnassignmentReason {
  MANUAL
  VENDOR_INACTIVE
  VENDOR_SUSPENDED
  SERVICE_AREA_REMOVED
  REROUTED
}

model OrderVendorAssignment {
  id Int @id @default(autoincrement())

  orderId String
  order   SellOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  source OrderVendorAssignmentSource
  reason OrderVendorAssignmentReason

  prioritySnapshot Int?

  assignedAt DateTime @default(now())

  unassignedAt       DateTime?
  unassignmentReason OrderVendorUnassignmentReason?

  createdAt DateTime @default(now())

  @@index([orderId, assignedAt])
  @@index([vendorId, unassignedAt, assignedAt])
}

model OrderAddressSnapshot {
  id              Int                 @id @default(autoincrement())
  orderId         String              @unique
  order           SellOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceAddressId Int?
  sourceAddress   CustomerAddress?    @relation(fields: [sourceAddressId], references: [id], onDelete: SetNull)
  fullName        String
  phone           String
  house           String
  street          String
  locality        String
  landmark        String?
  pincode         String
  city            String
  state           String
  type            CustomerAddressType
  createdAt       DateTime            @default(now())
  email           String?

  @@index([sourceAddressId])
  @@index([pincode])
}

model OrderStatusHistory {
  id        Int             @id @default(autoincrement())
  orderId   String
  order     SellOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    SellOrderStatus
  note      String?
  createdAt DateTime        @default(now())

  @@index([orderId, createdAt])
  @@index([status])
}

model OrderRescheduleHistory {
  id            Int       @id @default(autoincrement())
  orderId       String
  order         SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldPickupDate DateTime  @db.Date
  newPickupDate DateTime  @db.Date
  oldSlotLabel  String
  newSlotLabel  String
  createdAt     DateTime  @default(now())

  @@index([orderId, createdAt])
}

// ============================================================
// ENQUIRY / FUNNEL / CANCELLATION TRACKING
// ============================================================

enum CancellationActor {
  CUSTOMER
  AGENT
  VENDOR
  ADMIN
  SYSTEM
}

model EnquirySession {
  id        String @id @default(cuid())
  sessionId String @unique
  phone     String

  productId          Int?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  identityVerifiedAt DateTime?

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  questionnaireCompletedAt DateTime?
  otpSentAt                DateTime?
  otpVerifiedAt            DateTime?
  quoteViewedAt            DateTime?

  quoteAmount Decimal? @db.Decimal(12, 2)

  orderId String?    @unique
  order   SellOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifiedSessionId String?
  verifiedSession   CustomerVerifiedSession? @relation(fields: [verifiedSessionId], references: [id], onDelete: SetNull)

  questionnaireSnapshot Json?

  @@index([phone])
  @@index([questionnaireCompletedAt])
  @@index([otpVerifiedAt])
  @@index([quoteViewedAt, orderId])
  @@index([createdAt])
  @@index([verifiedSessionId, quoteViewedAt])
  @@index([identityVerifiedAt])
}

model OrderCancellation {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  order SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actor CancellationActor

  reasonCode String?
  reasonText String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor, createdAt])
}

model CustomerVerifiedSession {
  id        String @id @default(cuid())
  tokenHash String @unique
  phone     String

  verifiedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  enquiries EnquirySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, expiresAt])
  @@index([expiresAt, revokedAt])
}

model ServiceablePincode {
  id      Int    @id @default(autoincrement())
  pincode String @unique

  district String?
  state    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorMappings VendorServiceArea[]

  @@index([isActive])
  @@index([updatedAt])
}

model CancellationReasonMaster {
  id               Int               @id @default(autoincrement())
  code             String
  label            String
  audience         CancellationActor
  requiresFreeText Boolean           @default(false)
  isActive         Boolean           @default(true)
  displayOrder     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([audience, code])
  @@index([audience, isActive, displayOrder])
}

model CustomerFeedbackOption {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  label            String
  requiresFreeText Boolean  @default(false)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model OrderFeedback {
  id      Int       @id @default(autoincrement())
  orderId String    @unique
  order   SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  rating              Int?
  optionCode          String?
  optionLabelSnapshot String?
  feedbackText        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Vendor {
  id Int @id @default(autoincrement())

  vendorCode   String  @unique
  businessName String
  contactName  String
  phone        String
  email        String?

  status VendorStatus @default(ACTIVE)

  serviceAreas VendorServiceArea[]
  memberships  VendorMembership[]
  sessions     VendorSession[]

  currentOrders    SellOrder[]
  orderAssignments OrderVendorAssignment[]

  agents                Agent[]
  agentOrderAssignments OrderAgentAssignment[]

  approvedApplication VendorApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessName])
  @@index([phone])
  @@index([createdAt])
}

model VendorServiceArea {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  serviceablePincodeId Int
  serviceablePincode   ServiceablePincode @relation(fields: [serviceablePincodeId], references: [id], onDelete: Restrict)

  priority Int @default(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, serviceablePincodeId])
  @@index([serviceablePincodeId, isActive, priority])
  @@index([vendorId, isActive])
}

enum VendorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VendorUserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

enum VendorRole {
  OWNER
  MANAGER
  OPERATIONS
}

enum VendorEmailOtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum VendorAuthTokenType {
  ACTIVATION
  PASSWORD_RESET
}

model VendorSession {
  id String @id @default(cuid())

  userId String
  user   VendorUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([vendorId, revokedAt])
  @@index([expiresAt])
}

// ============================================================
// VENDOR ONBOARDING / AUTHENTICATION
// ============================================================

model VendorApplication {
  id String @id @default(cuid())

  businessName String
  contactName  String

  email           String
  normalizedEmail String

  mobile           String
  normalizedMobile String

  emailVerifiedAt DateTime

  panEncrypted   String?
  panFingerprint String?
  panLast4       String?

  aadhaarEncrypted   String?
  aadhaarFingerprint String?
  aadhaarLast4       String?

  status VendorApplicationStatus @default(PENDING)

  rejectionReason String?

  approvedVendorId Int?    @unique
  approvedVendor   Vendor? @relation(fields: [approvedVendorId], references: [id], onDelete: Restrict)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedEmail, status])
  @@index([normalizedMobile, status])
  @@index([panFingerprint])
  @@index([status, createdAt])
}

model VendorEmailOtp {
  id String @id @default(cuid())

  emailNormalized String
  otpHash         String

  expiresAt  DateTime
  verifiedAt DateTime?

  verificationTokenHash String?
  consumedAt            DateTime?

  attempts Int                   @default(0)
  purpose  VendorEmailOtpPurpose @default(SIGNUP)

  createdAt DateTime @default(now())

  @@index([emailNormalized, createdAt])
}

model VendorUser {
  id String @id @default(cuid())

  email           String
  normalizedEmail String @unique

  passwordHash String?

  status VendorUserStatus @default(PENDING_ACTIVATION)

  mustChangePassword         Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime?

  memberships VendorMembership[]
  authTokens  VendorAuthToken[]
  sessions    VendorSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VendorMembership {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  userId String
  user   VendorUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  role VendorRole @default(OWNER)

  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
}

model VendorAuthToken {
  id String @id @default(cuid())

  userId String
  user   VendorUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      VendorAuthTokenType
  tokenHash String              @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
}

// ============================================================
// VENDOR AGENT MANAGEMENT / ORDER ASSIGNMENT
// ============================================================

enum AgentStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
  SUSPENDED
}

enum AgentEmailOtpPurpose {
  SIGNUP
}

model AgentEmailOtp {
  id String @id

  emailNormalized String
  otpHash         String

  expiresAt  DateTime
  verifiedAt DateTime?

  verificationTokenHash String?
  consumedAt            DateTime?

  attempts Int                  @default(0)
  purpose  AgentEmailOtpPurpose @default(SIGNUP)

  createdAt DateTime @default(now())

  @@index([emailNormalized, createdAt])
}

enum OrderAgentAssignmentSource {
  VENDOR
  REASSIGN
}

enum OrderAgentUnassignmentReason {
  REASSIGNED
  MANUAL
  AGENT_INACTIVE
  AGENT_SUSPENDED
}

model Agent {
  id Int @id @default(autoincrement())

  agentCode String @unique

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  fullName String

  mobile           String
  normalizedMobile String @unique

  email           String
  normalizedEmail String @unique

  aadhaarNumber String @unique
  address       String

  passwordHash String

  emailVerifiedAt DateTime

  status   AgentStatus    @default(PENDING_APPROVAL)
  sessions AgentSession[]

  rejectionReason String?
  reviewedAt      DateTime?

  orderAssignments OrderAgentAssignment[]
  orderEvents      OrderEvent[]
  inspection AgentOrderInspection[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([vendorId, status])
  @@index([vendorId, createdAt])
  @@index([status])
}

model AgentSession {
  id String @id @default(cuid())

  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([agentId, revokedAt])
  @@index([expiresAt])
}

model OrderAgentAssignment {
  id Int @id @default(autoincrement())

  orderId String
  order   SellOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  source OrderAgentAssignmentSource @default(VENDOR)

  assignedAt DateTime @default(now())

  unassignedAt       DateTime?
  unassignmentReason OrderAgentUnassignmentReason?

  createdAt DateTime @default(now())

  @@index([orderId, unassignedAt])
  @@index([agentId, unassignedAt])
  @@index([vendorId, unassignedAt, assignedAt])
  @@index([orderId, assignedAt])
}

enum OrderVerificationPurpose {
  INSPECTION_START
  QUOTE_ACCEPT
  QUOTE_REJECT
}

enum OrderVerificationChannel {
  SMS
  EMAIL
}

enum OrderVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  CONSUMED
}

enum OrderEventType {
  ORDER_CREATED
  VENDOR_ASSIGNED
  VENDOR_UNASSIGNED
  AGENT_ASSIGNED
  AGENT_UNASSIGNED
  VERIFICATION_SENT
  VERIFICATION_VERIFIED
  INSPECTION_STARTED
  INSPECTION_COMPLETED
  QUOTE_GENERATED
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  PAYMENT_COMPLETED
  ORDER_COMPLETED
  ORDER_CANCELLED
}

enum OrderEventActorType {
  SYSTEM
  CUSTOMER
  VENDOR
  AGENT
  SUPER_ADMIN
}

model OrderVerificationChallenge {
  id       String @id @default(cuid())
  orderId  String
  provider String

  order SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  purpose OrderVerificationPurpose
  channel OrderVerificationChannel

  // EMAIL OTP only. SMS OTP may remain provider-managed.
  otpHash String?

  // Never stores the raw destination.
  destinationMasked      String
  destinationFingerprint String

  // Later binds QUOTE_ACCEPT / QUOTE_REJECT OTP
  // to the exact authoritative quote.
  contextHash String?

  status   OrderVerificationStatus @default(PENDING)
  attempts Int                     @default(0)

  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, purpose, status, createdAt])
  @@index([expiresAt, status])
}

model OrderEvent {
  id String @id @default(cuid())

  orderId String
  order   SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType OrderEventType
  actorType OrderEventActorType

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Prevent duplicate logical audit events on retries/double-clicks.
  idempotencyKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([orderId, eventType, createdAt])
  @@index([agentId, createdAt])
}


// ============================================================
// AGENT DEVICE INSPECTION
// ============================================================

enum AgentInspectionStatus {
  IN_PROGRESS
  COMPLETED
}

model AgentOrderInspection {
  id String @id @default(cuid())

  // Exactly one inspection per order.
  orderId String    @unique
  order   SellOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  // Vendor isolation.
  vendorId Int

  status AgentInspectionStatus @default(IN_PROGRESS)

  // Product/variant captured when inspection starts.
  productId Int
  variantId Int

  // Agent questionnaire answers.
  // Customer questionnaireSnapshot remains untouched.
  answers Json?

  // ============================================================
  // AUTHORITATIVE AGENT QUOTE SNAPSHOT
  // Calculated ONLY by backend using DB-configured pricing rules.
  // Frontend must never supply these values.
  // ============================================================

  quoteBasePrice      Decimal? @db.Decimal(12, 2)
  quoteRawDeduction   Decimal? @db.Decimal(12, 2)
  quoteTotalDeduction Decimal? @db.Decimal(12, 2)
  quoteFinalPrice     Decimal? @db.Decimal(12, 2)

  // Frozen server-side calculation/audit snapshot.
  quoteSnapshot Json?

  // Fingerprint of the authoritative generated quote.
  // Used later for quote-bound ACCEPT/REJECT OTP.
  quoteHash String? @unique

  quoteGeneratedAt DateTime?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, status, updatedAt])
  @@index([vendorId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([vendorId, quoteGeneratedAt])
}

enum AgentQuoteDecision {
  ACCEPTED
  REJECTED
}